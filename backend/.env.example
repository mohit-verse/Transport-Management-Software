# ==============================================================================
# SSRL Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide environment-specific values.
# NEVER commit production .env or secret credentials to version control.
# ==============================================================================

# Runtime environment (development | test | production)
NODE_ENV=development

# HTTP server port
PORT=3000

# PostgreSQL connection string
# Production format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/srl_db

# Cryptographic secret for signing and verifying JWT authentication tokens
# MUST be at least 32 characters long in all environments
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_long_secret_key

# Minimum log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Persistent storage directory for uploaded documents and generated PDFs
# Development default: ../../../storage/development
# Production: REQUIRED. Must point to a durable, persistent volume mount (e.g., /var/lib/ssrl/storage)
STORAGE_DIR=

# Allowed web origin(s) for Cross-Origin Resource Sharing (CORS)
# Development default: *
# Production: REQUIRED. Must be an explicit origin (e.g., https://app.ssrl.in) or comma-separated list
CORS_ORIGIN=

# PostgreSQL SSL / TLS Configuration
# Set to 'true' to require TLS connections for managed cloud databases (AWS RDS, GCP Cloud SQL, Supabase)
DATABASE_SSL=false

# Optional CA certificate path or inline CA certificate for database TLS verification
DATABASE_SSL_CA=

# Initial Owner Provisioning (Used ONLY by `npm run seed:owner` CLI script)
# Credentials supplied at execution time, never committed.
# INITIAL_OWNER_NAME="SSRL Owner"
# INITIAL_OWNER_MOBILE="9876543210"
# INITIAL_OWNER_PASSWORD="your_strong_admin_password_min_8_chars"
